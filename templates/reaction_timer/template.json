{
  "name": "reaction_timer",
  "description": "Press to start; after a random 1-3 s delay the LED lights; press again as fast as you can and the reaction time in milliseconds appears on the 7-segment display. Pressing early shows EEEE.",
  "top": "reaction_timer",
  "lib": ["debounce", "tick_gen", "lfsr", "seven_seg"],
  "requires": { "seg": 7, "digit": 4 },
  "params": {
    "CLK_HZ": "clock_hz",
    "N_DIGIT": "count:digit|max:8",
    "BTN_ACTIVE_LOW": "active_low:button",
    "LED_ACTIVE_LOW": "active_low:led",
    "SEG_ACTIVE_LOW": "active_low:seg",
    "DIGIT_ACTIVE_LOW": "active_low:digit"
  },
  "ports": {
    "clk": { "role": "clock" },
    "btn": { "role": "button" },
    "led": { "role": "led" },
    "seg": { "role": "seg", "width": 7 },
    "dp":  { "role": "dp" },
    "an":  { "role": "digit", "width": "N_DIGIT" }
  }
}
