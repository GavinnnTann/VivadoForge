{
    "files.associations": {
        "*.v": "verilog",
        "*.vh": "verilog",
        "*.sv": "systemverilog",
        "*.svh": "systemverilog",
        "*.xdc": "tcl"
    },
    "files.exclude": {
        "**/.Xil": true,
        "**/__pycache__": true
    },
    "search.exclude": {
        "build/**": true,
        "boards/*/master.xdc": false
    },
    "files.watcherExclude": {
        "build/**": true
    },
    "verilog.linting.linter": "none",
    "editor.rulers": [100],
    "[verilog]": { "editor.tabSize": 4, "editor.insertSpaces": true },
    "[systemverilog]": { "editor.tabSize": 4, "editor.insertSpaces": true },
    "python.analysis.extraPaths": ["scripts"]
}
