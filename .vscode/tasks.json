// VivadoForge tasks: Ctrl+Shift+B builds; 'Tasks: Run Test Task' simulates.
// Errors from forge, Vivado and the simulators appear in the Problems panel (Ctrl+Shift+M).
// Program and Flash ask for confirmation in the terminal before touching the board.
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FPGA: Build (synthesis + implementation + bitstream)",
            "type": "shell",
            "command": "python",
            "linux": {
                "command": "python3"
            },
            "osx": {
                "command": "python3"
            },
            "args": [
                "scripts/forge.py",
                "build"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [
                {
                    "owner": "forge",
                    "source": "forge",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "severity": "error",
                    "pattern": {
                        "regexp": "^\\s*(?:ERROR|CRITICAL)\\s+\\[([^\\]]+)\\]\\s+(.*?)\\s+-->\\s+(.+?):(\\d+)\\s*$",
                        "message": 2,
                        "file": 3,
                        "line": 4,
                        "code": 1
                    }
                },
                {
                    "owner": "forge",
                    "source": "forge",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "severity": "warning",
                    "pattern": {
                        "regexp": "^\\s*WARN\\s+\\[([^\\]]+)\\]\\s+(.*?)\\s+-->\\s+(.+?):(\\d+)\\s*$",
                        "message": 2,
                        "file": 3,
                        "line": 4,
                        "code": 1
                    }
                },
                {
                    "owner": "forge",
                    "source": "forge",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "severity": "error",
                    "pattern": {
                        "regexp": "^\\s*ERROR:\\s*\\[([^\\]]+)\\]\\s*(.*?)\\s*\\[([^\\[\\]]+):(\\d+)\\]\\s*$",
                        "message": 2,
                        "file": 3,
                        "line": 4,
                        "code": 1
                    }
                },
                {
                    "owner": "forge",
                    "source": "forge",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "severity": "warning",
                    "pattern": {
                        "regexp": "^\\s*CRITICAL WARNING:\\s*\\[([^\\]]+)\\]\\s*(.*?)\\s*\\[([^\\[\\]]+):(\\d+)\\]\\s*$",
                        "message": 2,
                        "file": 3,
                        "line": 4,
                        "code": 1
                    }
                }
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "FPGA: Simulate (all testbenches)",
            "type": "shell",
            "command": "python",
            "linux": {
                "command": "python3"
            },
            "osx": {
                "command": "python3"
            },
            "args": [
                "scripts/forge.py",
                "sim"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [
                {
                    "owner": "forge",
                    "source": "forge",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "severity": "error",
                    "pattern": {
                        "regexp": "^\\s*ERROR:\\s*\\[([^\\]]+)\\]\\s*(.*?)\\s*\\[([^\\[\\]]+):(\\d+)\\]\\s*$",
                        "message": 2,
                        "file": 3,
                        "line": 4,
                        "code": 1
                    }
                },
                {
                    "owner": "forge",
                    "source": "forge",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "severity": "error",
                    "pattern": {
                        "regexp": "^\\s*(.+?\\.s?v):(\\d+):\\s*((?:syntax error|error).*)$",
                        "message": 3,
                        "file": 1,
                        "line": 2
                    }
                }
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "FPGA: Simulate and open waveforms",
            "type": "shell",
            "command": "python",
            "linux": {
                "command": "python3"
            },
            "osx": {
                "command": "python3"
            },
            "args": [
                "scripts/forge.py",
                "sim",
                "--gui"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [
                {
                    "owner": "forge",
                    "source": "forge",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "severity": "error",
                    "pattern": {
                        "regexp": "^\\s*ERROR:\\s*\\[([^\\]]+)\\]\\s*(.*?)\\s*\\[([^\\[\\]]+):(\\d+)\\]\\s*$",
                        "message": 2,
                        "file": 3,
                        "line": 4,
                        "code": 1
                    }
                },
                {
                    "owner": "forge",
                    "source": "forge",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "severity": "error",
                    "pattern": {
                        "regexp": "^\\s*(.+?\\.s?v):(\\d+):\\s*((?:syntax error|error).*)$",
                        "message": 3,
                        "file": 1,
                        "line": 2
                    }
                }
            ],
            "group": "test"
        },
        {
            "label": "FPGA: Check (pins, clock, config)",
            "type": "shell",
            "command": "python",
            "linux": {
                "command": "python3"
            },
            "osx": {
                "command": "python3"
            },
            "args": [
                "scripts/forge.py",
                "check"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [
                {
                    "owner": "forge",
                    "source": "forge",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "severity": "error",
                    "pattern": {
                        "regexp": "^\\s*(?:ERROR|CRITICAL)\\s+\\[([^\\]]+)\\]\\s+(.*?)\\s+-->\\s+(.+?):(\\d+)\\s*$",
                        "message": 2,
                        "file": 3,
                        "line": 4,
                        "code": 1
                    }
                },
                {
                    "owner": "forge",
                    "source": "forge",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "severity": "warning",
                    "pattern": {
                        "regexp": "^\\s*WARN\\s+\\[([^\\]]+)\\]\\s+(.*?)\\s+-->\\s+(.+?):(\\d+)\\s*$",
                        "message": 2,
                        "file": 3,
                        "line": 4,
                        "code": 1
                    }
                }
            ]
        },
        {
            "label": "FPGA: Program (volatile)",
            "type": "shell",
            "command": "python",
            "linux": {
                "command": "python3"
            },
            "osx": {
