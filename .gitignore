# VivadoForge .gitignore

# Build output (forge.py writes everything here; `forge.py clean` deletes it)
build/

# Per-machine settings: Vivado path, build folder
forge.local.toml

# Vivado droppings if Vivado is ever run from the repository folder
.Xil/
*.jou
*.log
*.str
vivado*.backup.*
vivado_pid*
hs_err_pid*
webtalk*
xsim.dir/
*.wdb
*.vcd
*.pb
usage_statistics_webtalk.*

# Python
__pycache__/
*.py[cod]

# Editors and OS
.vscode/*.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini

# Claude Code local settings (the shared .claude/settings.json is committed)
.claude/settings.local.json
